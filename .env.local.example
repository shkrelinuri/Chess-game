NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# RevenueCat public SDK keys: configure one project with a `premium` entitlement,
# monthly and annual packages for each platform, and products mapped to premium.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_REVENUECAT_WEB_KEY=

# Public HTTPS service URLs. For a native build these must be reachable from devices.
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Node API service configuration.
DATABASE_URL=postgres://localhost:5432/endgame
FIREBASE_SERVICE_ACCOUNT_JSON=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer-change-this-to-a-long-random-secret
REVENUECAT_WEBHOOK_HMAC_SECRET=
WEB_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
API_PORT=3002
SOCKET_PORT=3001